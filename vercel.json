{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/media/catalog/:assetPath*",
      "destination": "https://vlpdiyicmupghfcualoe.supabase.co/storage/v1/object/public/hard-public-catalog/:assetPath*"
    },
    {
      "source": "/:__hard_path((?!(?:admin|login|api|static|assets|cms)(?:/|$)|(?:realestate|construction|hvac)/(?:admin|cms)(?:/|$))[a-zA-Z0-9][a-zA-Z0-9/-]{0,499})",
      "destination": "/api/hard-redirect"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/hard-redirect.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "redirects": [
    { "source": "/admin/operations", "destination": "/admin", "permanent": true },
    {
      "source": "/admin/supabase-inbox",
      "destination": "/admin",
      "permanent": true
    }
  ]
}
