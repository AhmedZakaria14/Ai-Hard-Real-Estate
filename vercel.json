{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/media/catalog/:assetPath*",
      "destination": "https://vlpdiyicmupghfcualoe.supabase.co/storage/v1/object/public/hard-public-catalog/:assetPath*"
    },
    {
      "source": "/:__hard_path((?!(?:admin|login|api|static|assets|cms)(?:/|$)|(?:realestate|construction|hvac)/(?:admin|cms)(?:/|$))[a-zA-Z0-9][a-zA-Z0-9/-]{0,499})",
      "destination": "/api/hard-redirect"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/hard-redirect.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "redirects": [
    {
      "source": "/admin/operations",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/admin/supabase-inbox",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/cms",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/realestate/admin",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/realestate/cms",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/construction/cms",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/hvac/cms",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/admin/cms",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/construction/admin",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/hvac/admin",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/maintenance/admin",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/maintenance/cms",
      "destination": "/admin",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/realestate/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/construction/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/hvac/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
