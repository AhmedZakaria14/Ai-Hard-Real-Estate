{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/qa-redirect-301-1711",
      "destination": "/api/hard-redirect?__hard_path=qa-redirect-301-1711"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/hard-redirect.ts": {
      "includeFiles": "dist/index.html"
    }
  }
}
